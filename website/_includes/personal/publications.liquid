<header class="page-heading"><h1>Publications</h1><p>Published research and manuscripts in progress.</p></header>
<div class="filters publication-filters" role="group" aria-label="Filter publications" hidden>
<button class="filter active" data-paper-filter="all" aria-pressed="true">All</button>
<button class="filter" data-paper-filter="in-progress" aria-pressed="false">In progress</button>
<button class="filter" data-paper-filter="published" aria-pressed="false">Published</button>
</div>
<p id="publication-count" class="small-note" role="status" aria-live="polite"></p>
<div class="publication-list">
{% assign papers = site.data.publications | sort: 'date' | reverse %}
{% for paper in papers %}
<article class="card publication-card" data-paper-status="{{ paper.status | escape }}">
<div class="item-meta"><span>{% if paper.status == 'published' %}Published{% else %}In progress{% endif %}</span>{% if paper.date != '' %}<time datetime="{{ paper.date | escape }}">{{ paper.date | date: '%Y' }}</time>{% endif %}</div>
<h2>{{ paper.title | escape }}</h2>
{% if paper.authors != '' %}<p class="publication-authors">{{ paper.authors | escape }}</p>{% endif %}
{% if paper.venue != '' %}<p class="organization">{{ paper.venue | escape }}</p>{% endif %}
{% if paper.summary != '' %}<p class="publication-summary">{{ paper.summary | escape }}</p>{% endif %}
{% if paper.url != '' %}<a class="text-link" href="{{ paper.url | escape }}" target="_blank" rel="noopener noreferrer">Read paper <span aria-hidden="true">↗</span></a>{% endif %}
</article>
{% endfor %}
</div>
<p id="publication-empty" class="card publication-card" hidden>No papers in this category yet.</p>
