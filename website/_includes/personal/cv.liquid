<header class="page-heading split-heading">
  <div><p class="eyebrow">The experience behind the work</p><h1>CV</h1><p>Explore my teaching, research, or the complete CV.</p></div>
  <div class="cv-actions">{% if site.data.personal.cvPdf != '' %}<a class="button" href="{{ site.data.personal.cvPdf | relative_url }}" target="_blank" rel="noopener">Research résumé PDF <span aria-hidden="true">↓</span></a>{% endif %}<button class="text-link print-button">Print this view ↗</button></div>
</header>
<div class="experience-tabs" role="tablist" aria-label="Choose an experience view">
  <button class="card experience-tab" id="tab-teaching" role="tab" aria-selected="false" aria-controls="panel-teaching" tabindex="-1" data-experience-view="teaching"><span class="experience-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="m2 8 10-5 10 5-10 5L2 8Zm4 2v6c4 3 8 3 12 0v-6M22 8v8"/></svg></span><span class="experience-tab-copy"><span class="experience-tab-title">Teaching</span><span class="experience-tab-description">Courses, mentoring & outreach</span></span><span class="experience-tab-arrow" aria-hidden="true">↗</span></button>
  <button class="card experience-tab" id="tab-research" role="tab" aria-selected="false" aria-controls="panel-research" tabindex="-1" data-experience-view="research"><span class="experience-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M8 3h8M10 3v7l-6 9a1.3 1.3 0 0 0 1 2h14a1.3 1.3 0 0 0 1-2l-6-9V3M7 15h10"/></svg></span><span class="experience-tab-copy"><span class="experience-tab-title">Research</span><span class="experience-tab-description">Research roles, methods & publications</span></span><span class="experience-tab-arrow" aria-hidden="true">↗</span></button>
  <button class="card experience-tab" id="tab-complete" role="tab" aria-selected="true" aria-controls="panel-complete" tabindex="0" data-experience-view="complete"><span class="experience-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 2h8l4 4v16H6V2Zm8 0v5h4M9 11h6M9 15h6M9 18h4"/></svg></span><span class="experience-tab-copy"><span class="experience-tab-title">Complete CV</span><span class="experience-tab-description">All experience, education & skills</span></span><span class="experience-tab-arrow" aria-hidden="true">↗</span></button>
</div>
<noscript><p class="small-note">The complete CV is shown below. Enable JavaScript to switch to a focused Teaching or Research view.</p></noscript>
{% assign experience_views = 'teaching,research,complete' | split: ',' %}
{% for view in experience_views %}
<section id="panel-{{ view }}" class="experience-panel" role="tabpanel" aria-labelledby="tab-{{ view }}" tabindex="0" {% unless view == 'complete' %}hidden{% endunless %}>
  <div class="cv-layout">
    <aside class="cv-sidebar card"><p class="eyebrow">On this page</p><nav aria-label="{{ view | capitalize }} sections"><a href="#{{ view }}-profile">Profile</a><a href="#{{ view }}-experience">Work experience</a>{% if view == 'teaching' %}<a href="#{{ view }}-courses">Courses</a>{% endif %}<a href="#{{ view }}-education">Education</a>{% if view == 'teaching' %}<a href="#{{ view }}-recognition">Teaching recognition</a><a href="#{{ view }}-outreach">Outreach</a>{% else %}<a href="#{{ view }}-publications">Publications</a><a href="#{{ view }}-skills">Skills</a>{% endif %}</nav><a class="text-link" href="mailto:{{ site.data.personal.email | escape }}">Contact me ↗</a></aside>
    <div class="cv-main">
      <section id="{{ view }}-profile" class="card cv-section"><p class="eyebrow">{% if view == 'complete' %}Complete CV{% else %}{{ view | capitalize }} profile{% endif %}</p><h2>{{ site.data.personal.name | escape }}</h2><p>{% if view == 'teaching' %}{{ site.data.personal.home.teaching.description | escape }}{% elsif view == 'research' %}{{ site.data.personal.home.research.description | escape }}{% else %}{{ site.data.personal.bio | escape }}{% endif %}</p><p class="muted">{{ site.data.personal.location | escape }}</p></section>
      <section id="{{ view }}-experience" class="card cv-section"><h2>{% if view == 'teaching' %}Teaching experience{% elsif view == 'research' %}Research experience{% else %}Work experience{% endif %}</h2>
      {% if view == 'complete' %}{% assign roles = site.data.cv.work %}{% else %}{% assign roles = site.data.cv.work | where: 'category', view %}{% endif %}
      {% for item in roles %}<article class="cv-entry"><div class="cv-entry-heading"><h3>{{ item.position | escape }}</h3><span>{% if item.startDate != '' %}{{ item.startDate | slice: 0, 7 }}{% if item.current %} — Present{% elsif item.endDate != '' %} — {{ item.endDate | slice: 0, 7 }}{% endif %}{% elsif item.current %}Current{% endif %}</span></div><p class="organization">{{ item.name | escape }}</p><ul>{% for detail in item.highlights %}<li>{{ detail | escape }}</li>{% endfor %}</ul></article>{% else %}<p>Further experience will be added here.</p>{% endfor %}
      </section>
      {% if view == 'teaching' %}<section id="{{ view }}-courses" class="card cv-section"><h2>Courses & mentoring</h2>{% for item in site.data.personal.teaching %}<article class="cv-entry"><div class="cv-entry-heading"><h3>{{ item.course | escape }}</h3><span>{{ item.date | escape }}</span></div><p class="organization">{{ item.code | escape }} · {{ item.institution | escape }}</p><p>{{ item.description | escape }}</p></article>{% endfor %}</section>{% endif %}
      <section id="{{ view }}-education" class="card cv-section"><h2>Academic background</h2>{% for item in site.data.cv.education %}<article class="cv-entry"><div class="cv-entry-heading"><h3>{{ item.studyType | escape }} · {{ item.area | escape }}</h3><span>{{ item.startDate | slice: 0, 4 }} — {% if item.endDate != '' %}{{ item.endDate | slice: 0, 4 }}{% else %}Present{% endif %}</span></div><p class="organization">{{ item.institution | escape }}</p><p>{{ item.summary | escape }}</p></article>{% endfor %}</section>
      {% if view == 'teaching' %}
      <section id="{{ view }}-recognition" class="card cv-section"><h2>Teaching recognition</h2>{% assign awards = site.data.achievements | where: 'category', 'Teaching' %}{% for award in awards %}<article class="cv-entry"><h3>{{ award.title | escape }}</h3><p class="organization">{{ award.organization | escape }} · {{ award.year | escape }}</p></article>{% endfor %}</section>
      <section id="{{ view }}-outreach" class="card cv-section"><h2>Beyond the classroom</h2><p>{{ site.data.personal.outreach | escape }}</p></section>
      {% else %}
      <section id="{{ view }}-publications" class="card cv-section"><h2>Published research</h2>{% for item in site.data.cv.publications %}<article class="cv-entry"><h3><a href="{{ item.url | escape }}" target="_blank" rel="noopener noreferrer">{{ item.name | escape }} ↗</a></h3><p class="organization">{{ item.publisher | escape }} · {{ item.releaseDate | slice: 0, 4 }}</p></article>{% endfor %}</section>
      <section id="{{ view }}-skills" class="card cv-section"><h2>Tools I work with</h2><div class="tags large-tags">{% for skill in site.data.personal.skills %}<span>{{ skill | escape }}</span>{% endfor %}</div></section>
      {% endif %}
    </div>
  </div>
</section>
{% endfor %}
