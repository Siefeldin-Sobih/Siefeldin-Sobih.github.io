<div class="home-top">
<section class="card identity-card" aria-labelledby="intro-title">
{% if site.data.personal.photo != '' %}<img class="portrait" src="{{ site.data.personal.photo | relative_url }}" alt="{{ site.data.personal.photoAlt | escape }}" width="300" height="370">
{% else %}<div class="identity-art" aria-label="Saif’s monogram"><span class="art-coordinate">MATH · DATA · ROBOTICS</span><span class="monogram">s<span>.</span></span><span class="art-bottom">Siefeldin Sobih<br>Logan, Utah</span></div>{% endif %}
<div class="identity-copy"><p class="eyebrow">{{ site.data.personal.role | escape }}</p><h1 id="intro-title">{{ site.data.personal.name | escape }}</h1><p class="intro">{{ site.data.personal.intro | escape }}</p><div class="hero-actions"><a class="button" href="{{ 'cv/' | relative_url }}">View my CV <span aria-hidden="true">↗</span></a><a class="icon-link" href="https://github.com/Siefeldin-Sobih" aria-label="Saif on GitHub">{% include personal/github.svg %}</a></div></div>
</section>
<aside class="card updates-card" aria-labelledby="updates-title"><div class="card-heading"><h2 id="updates-title">Recent updates</h2><span class="small-dot" aria-hidden="true"></span></div><ol class="update-list">{% for item in site.data.updates limit:3 %}<li><a href="{{ item.url | relative_url }}"><span class="update-date">{{ item.label | escape }}</span><span class="update-text">{{ item.text | escape }}</span><span class="update-arrow" aria-hidden="true">↗</span></a></li>{% endfor %}</ol><a class="text-link" href="{{ 'updates/' | relative_url }}">All updates <span aria-hidden="true">→</span></a></aside>
</div>
<div class="current-grid">
<section class="card current-card{% if site.data.personal.home.teaching.image == '' %} current-text-only{% endif %}">{% if site.data.personal.home.teaching.image != '' %}<img src="{{ site.data.personal.home.teaching.image | relative_url }}" alt="{{ site.data.personal.home.teaching.imageAlt | escape }}" width="340" height="310">{% endif %}<div class="current-copy"><p class="eyebrow">{{ site.data.personal.home.teaching.heading | escape }}</p><h2>{{ site.data.personal.home.teaching.title | escape }}</h2><p>{{ site.data.personal.home.teaching.description | escape }}</p><a class="button button-secondary" href="{{ site.data.personal.home.teaching.url | relative_url }}">Learn more <span aria-hidden="true">↗</span></a></div></section>
<section class="card current-card{% if site.data.personal.home.research.image == '' %} current-text-only{% endif %}">{% if site.data.personal.home.research.image != '' %}<img src="{{ site.data.personal.home.research.image | relative_url }}" alt="{{ site.data.personal.home.research.imageAlt | escape }}" width="340" height="310">{% endif %}<div class="current-copy"><p class="eyebrow">{{ site.data.personal.home.research.heading | escape }}</p><h2>{{ site.data.personal.home.research.title | escape }}</h2><p>{{ site.data.personal.home.research.description | escape }}</p><a class="button button-secondary" href="{{ site.data.personal.home.research.url | relative_url }}">Learn more <span aria-hidden="true">↗</span></a></div></section>
</div>
<div class="quiet-note"><span class="small-dot" aria-hidden="true"></span><p>Interested in the work behind the words? <a href="{{ 'work/' | relative_url }}">Explore my projects <span aria-hidden="true">→</span></a></p></div>
